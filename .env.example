# ==============================================================================
# GridWise Environment Configuration
# ==============================================================================
# DO NOT commit actual API keys or secrets to version control.
# Copy this file to .env and set your credentials locally or in Render Dashboard.

# NVIDIA NIM Configuration
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Generic Fallback LLM Configuration (Optional)
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Execution Timeouts (seconds)
LLM_TIMEOUT_SECONDS=12
SOLVER_TIMEOUT_SECONDS=8

# Server Port (Render sets this dynamically via $PORT)
PORT=8000
HOST=0.0.0.0
